# Copy to .env.local for development, or .env on the server.

# --- Auth.js -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth client, from https://console.cloud.google.com/apis/credentials
# Create an "OAuth client ID" of type "Web application" and add these
# Authorized redirect URIs:
#   https://YOUR-HOST/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google      (for local development)
# Google rejects bare IP addresses, which is why the box needs a hostname.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Public origin of the deployment. Must match the redirect URI's origin.
AUTH_URL=https://nexusnight.duckdns.org
NEXUS_SITE_URL=https://nexusnight.duckdns.org

# --- Storage -----------------------------------------------------------------
# Path to the config file (optional; defaults to ./nexus.config.json)
# NEXUS_CONFIG=/etc/nexus-night/config.json
# Overrides dataDir from the config file (optional)
# NEXUS_DATA_DIR=/srv/nexus-night/data
